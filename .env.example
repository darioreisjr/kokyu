# Supabase Auth — local development stack (`supabase start` in the
# kokyu-sam backend repo). Both the anon/publishable key and the URL are
# safe to expose to the browser: they're subject to Row Level Security,
# never bypass it. For staging/production values, see kokyu-sam's
# docs/deployment.md — never point local development at those projects.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (CAPTCHA) - public site key, safe to expose to the browser.
# Used to render the Turnstile widget on signup/login/forgot-password.
# The matching Secret Key lives only in Supabase (Authentication > Attack
# Protection), never in this frontend.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# kokyu-sam backend (NestJS) — local development default. Includes the
# `/api/v1` prefix; every call this app makes (via `lib/api/*`) appends
# a path like `/me` directly onto this. Safe to expose to the browser:
# some calls (username availability, the direct-to-Supabase-Storage
# avatar upload flow) happen from the browser itself. Update this to
# match wherever the backend repo's own local dev server actually
# listens if it differs from this default.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
